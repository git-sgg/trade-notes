#!/bin/sh
# Maven Wrapper bootstrap script
set -e

APP_NAME="Maven Wrapper"
APP_BASE_NAME=$(basename "$0")

# Find java
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

WRAPPER_JAR=".mvn/wrapper/maven-wrapper.jar"
WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.1/maven-wrapper-3.3.1.jar"
DIST_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.6/apache-maven-3.9.6-bin.zip"

if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Downloading Maven Wrapper..."
    mkdir -p .mvn/wrapper
    curl -fsSL "$WRAPPER_URL" -o "$WRAPPER_JAR" || {
        echo "Failed to download Maven Wrapper JAR"
        exit 1
    }
fi

exec "$JAVACMD" $JAVA_OPTS -jar "$WRAPPER_JAR" "$@"
